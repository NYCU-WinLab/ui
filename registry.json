{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "winlab",
  "homepage": "https://ui.winlab.tw",
  "items": [
    {
      "name": "base",
      "type": "registry:base",
      "title": "WinLab Base",
      "description": "WinLab design system base: Ultramarine (Pantone 286 C) brand tokens on a neutral scale.",
      "extends": "none",
      "config": {
        "style": "base-nova",
        "iconLibrary": "lucide",
        "tailwind": {
          "baseColor": "neutral"
        },
        "registries": {
          "@winlab": "https://ui.winlab.tw/r/{name}.json"
        }
      },
      "dependencies": [
        "class-variance-authority",
        "cn",
        "lucide-react",
        "@base-ui/react"
      ],
      "registryDependencies": [
        "utils",
        "https://ui.winlab.tw/r/font-inter.json",
        "https://ui.winlab.tw/r/font-noto-sans-jp.json",
        "https://ui.winlab.tw/r/font-noto-sans-tc.json",
        "https://ui.winlab.tw/r/font-jetbrains-mono.json"
      ],
      "devDependencies": [
        "tw-animate-css",
        "shadcn"
      ],
      "css": {
        "@import \"tw-animate-css\"": {},
        "@import \"shadcn/tailwind.css\"": {},
        "@layer base": {
          "*": {
            "@apply border-border outline-ring/50": {}
          },
          "body": {
            "@apply bg-background text-foreground": {}
          },
          "html": {
            "@apply font-sans": {}
          }
        }
      },
      "cssVars": {
        "theme": {
          "text-*": "initial",
          "text-title": "1.5rem",
          "text-title--line-height": "2rem",
          "text-body": "1rem",
          "text-body--line-height": "1.5rem",
          "font-sans": "var(--font-inter), var(--font-noto-sans-jp), var(--font-noto-sans-tc), sans-serif",
          "font-heading": "var(--font-inter), var(--font-noto-sans-jp), var(--font-noto-sans-tc), sans-serif",
          "font-mono": "var(--font-jetbrains-mono), var(--font-noto-sans-jp), var(--font-noto-sans-tc), monospace"
        },
        "light": {
          "radius": "1rem",
          "background": "oklch(1 0 0)",
          "foreground": "oklch(0.145 0 0)",
          "card": "oklch(1 0 0)",
          "card-foreground": "oklch(0.145 0 0)",
          "popover": "oklch(1 0 0)",
          "popover-foreground": "oklch(0.145 0 0)",
          "primary": "oklch(0.378 0.182 262.5)",
          "primary-foreground": "oklch(0.985 0 0)",
          "secondary": "oklch(0.97 0 0)",
          "secondary-foreground": "oklch(0.205 0 0)",
          "muted": "oklch(0.97 0 0)",
          "muted-foreground": "oklch(0.556 0 0)",
          "accent": "oklch(0.97 0 0)",
          "accent-foreground": "oklch(0.205 0 0)",
          "destructive": "oklch(0.577 0.245 27.325)",
          "border": "oklch(0.922 0 0)",
          "input": "oklch(0.922 0 0)",
          "ring": "oklch(0.378 0.182 262.5)",
          "chart-1": "oklch(0.87 0 0)",
          "chart-2": "oklch(0.556 0 0)",
          "chart-3": "oklch(0.439 0 0)",
          "chart-4": "oklch(0.371 0 0)",
          "chart-5": "oklch(0.269 0 0)",
          "sidebar": "oklch(0.985 0 0)",
          "sidebar-foreground": "oklch(0.145 0 0)",
          "sidebar-primary": "oklch(0.378 0.182 262.5)",
          "sidebar-primary-foreground": "oklch(0.985 0 0)",
          "sidebar-accent": "oklch(0.97 0 0)",
          "sidebar-accent-foreground": "oklch(0.205 0 0)",
          "sidebar-border": "oklch(0.922 0 0)",
          "sidebar-ring": "oklch(0.378 0.182 262.5)"
        },
        "dark": {
          "background": "oklch(0.145 0 0)",
          "foreground": "oklch(0.985 0 0)",
          "card": "oklch(0.205 0 0)",
          "card-foreground": "oklch(0.985 0 0)",
          "popover": "oklch(0.205 0 0)",
          "popover-foreground": "oklch(0.985 0 0)",
          "primary": "oklch(0.68 0.168 262.5)",
          "primary-foreground": "oklch(0.145 0 0)",
          "secondary": "oklch(0.269 0 0)",
          "secondary-foreground": "oklch(0.985 0 0)",
          "muted": "oklch(0.269 0 0)",
          "muted-foreground": "oklch(0.708 0 0)",
          "accent": "oklch(0.269 0 0)",
          "accent-foreground": "oklch(0.985 0 0)",
          "destructive": "oklch(0.704 0.191 22.216)",
          "border": "oklch(1 0 0 / 10%)",
          "input": "oklch(1 0 0 / 15%)",
          "ring": "oklch(0.68 0.168 262.5)",
          "chart-1": "oklch(0.87 0 0)",
          "chart-2": "oklch(0.556 0 0)",
          "chart-3": "oklch(0.439 0 0)",
          "chart-4": "oklch(0.371 0 0)",
          "chart-5": "oklch(0.269 0 0)",
          "sidebar": "oklch(0.205 0 0)",
          "sidebar-foreground": "oklch(0.985 0 0)",
          "sidebar-primary": "oklch(0.68 0.168 262.5)",
          "sidebar-primary-foreground": "oklch(0.145 0 0)",
          "sidebar-accent": "oklch(0.269 0 0)",
          "sidebar-accent-foreground": "oklch(0.985 0 0)",
          "sidebar-border": "oklch(1 0 0 / 10%)",
          "sidebar-ring": "oklch(0.68 0.168 262.5)"
        }
      }
    },
    {
      "name": "font-inter",
      "type": "registry:font",
      "title": "Inter",
      "font": {
        "family": "'Inter Variable', sans-serif",
        "provider": "google",
        "import": "Inter",
        "variable": "--font-inter",
        "subsets": [
          "latin"
        ],
        "dependency": "@fontsource-variable/inter"
      }
    },
    {
      "name": "font-noto-sans-jp",
      "type": "registry:font",
      "title": "Noto Sans JP",
      "font": {
        "family": "'Noto Sans JP Variable', sans-serif",
        "provider": "google",
        "import": "Noto_Sans_JP",
        "variable": "--font-noto-sans-jp",
        "subsets": [
          "latin"
        ],
        "dependency": "@fontsource-variable/noto-sans-jp"
      }
    },
    {
      "name": "font-noto-sans-tc",
      "type": "registry:font",
      "title": "Noto Sans TC",
      "font": {
        "family": "'Noto Sans TC Variable', sans-serif",
        "provider": "google",
        "import": "Noto_Sans_TC",
        "variable": "--font-noto-sans-tc",
        "subsets": [
          "latin"
        ],
        "dependency": "@fontsource-variable/noto-sans-tc"
      }
    },
    {
      "name": "font-jetbrains-mono",
      "type": "registry:font",
      "title": "JetBrains Mono",
      "font": {
        "family": "'JetBrains Mono Variable', monospace",
        "provider": "google",
        "import": "JetBrains_Mono",
        "variable": "--font-jetbrains-mono",
        "subsets": [
          "latin"
        ],
        "dependency": "@fontsource-variable/jetbrains-mono"
      }
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "Button with one size and three variants: default, secondary, outline.",
      "dependencies": [
        "@base-ui/react",
        "class-variance-authority",
        "cn"
      ],
      "files": [
        {
          "path": "registry/winlab/ui/button.tsx",
          "type": "registry:ui"
        }
      ]
    }
  ]
}
